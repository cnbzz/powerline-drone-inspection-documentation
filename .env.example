# =====================================================================
# Powerline Drone Inspection - Environment variables
# Bu dosyayi `.env` olarak kopyalayip kendi degerlerinizi giriniz.
# `.env` dosyasi git'e dahil edilmez.
# =====================================================================

# --- Database ---------------------------------------------------------
# SQLite icin dosya yolu (relative veya absolute). Default: outputs/db/faults.db
DATABASE_URL=sqlite:///outputs/db/faults.db

# --- Paths ------------------------------------------------------------
# Default path'leri override etmek icin (bos birakirsan config.yaml kullanilir).
DATA_DIR=
MODELS_DIR=
OUTPUTS_DIR=

# --- Logging ----------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE=outputs/logs/app.log

# --- External APIs (ileride doldurulacak) -----------------------------
# DJI SDK / thermal parser, harita servisleri vb.
DJI_SDK_LICENSE=
MAPBOX_TOKEN=

# --- Runtime ----------------------------------------------------------
# auto / cuda / cpu
DEVICE=auto
